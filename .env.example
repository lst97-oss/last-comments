# Payload CMS + public origin.
PAYLOAD_SECRET=
DATABASE_URL=postgres://demo:demo-secret-pw@127.0.0.1:5434/template_demo
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Compose: `production` in a deployed stack (rejects loopback origins).
NODE_ENV=development
# Compose: loopback-only host port for the app.
APP_PORT=3000
# Compose: prebuilt image for `docker compose up --no-build` (CD sets this).
LAST_COMMENTS_IMAGE=last-comments:local

# Business comments/auth database (same local Postgres, separate database).
BUSINESS_DATABASE_URL=postgres://business:business-secret-pw@127.0.0.1:5434/business_comments
BETTER_AUTH_URL=http://localhost:3000
# At least 32 characters. Also keys the rate-limit plugin's HMAC pseudonyms.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Docker Compose Postgres (the app URLs above must match).
POSTGRES_PASSWORD=demo-secret-pw
BUSINESS_DB_PASSWORD=business-secret-pw

# Overrides src/server/auth/auth.config.ts: better-auth, oidc-jwt, header, or a chain.
AUTH_PROVIDERS=
AUTH_OIDC_JWKS_URL=
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=

# Cloudflare Turnstile public testing keys; replace in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Ingress allowed to speak for the client in the rate-limit plugin
# (comma-separated CIDRs, or * to trust every source). Unset trusts loopback
# and private networks only.
RATE_LIMIT_TRUSTED_PROXY_CIDR=

# Compose `tunnel` profile: `docker compose --profile tunnel up -d`.
CLOUDFLARE_TUNNEL_TOKEN=

# Filter plugin is on by default; required only for its LLM engine.
OPENROUTER_API_KEY=

# Blog comments: site key from /moderation plus a site-bound pages:write key.
BLOG_SITE_KEY=
BLOG_PUBLISHER_API_KEY=

# Logging.
LOG_PRETTY=true
LOG_VERBOSE=false
LOG_COLOR=auto
