{
  "name": "last-comments-oss",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "imports": {
    "#vendor/*": "./vendor/*"
  },
  "scripts": {
    "dev": "bun run generate:scalar && bunx --bun vite dev --port 3000",
    "build": "bun run generate-routes && bun run generate:scalar && bun run generate:payload-admin-css && bun run generate:types && bun run generate:importmap && bunx --bun vite build",
    "start": "bun scripts/start.ts",
    "payload": "bunx --bun payload --disable-transpile",
    "generate:types": "bunx ${PAYLOAD_BUNX_FLAGS:-} payload ${PAYLOAD_CLI_ARGS:-} generate:types",
    "generate:importmap": "bunx ${PAYLOAD_BUNX_FLAGS:-} payload ${PAYLOAD_CLI_ARGS:-} generate:importmap",
    "db:migrate": "bun run payload migrate",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down",
    "db:business:generate": "bunx drizzle-kit generate",
    "db:business:migrate": "bun scripts/migrate-business.ts",
    "db:business:reset": "bun scripts/reset-business-dev.ts",
    "db:business:plugins:uninstall": "bun scripts/uninstall-business-plugin.ts",
    "db:business:grant-admin": "bun scripts/grant-business-admin.ts",
    "db:seed": "bun scripts/seeds/seed-posts.ts",
    "db:seed:blog-site": "bun scripts/seeds/seed-blog-site.ts",
    "db:seed:demo-comments": "bun scripts/seeds/seed-demo-comments.ts",
    "db:seed:load": "bun scripts/seeds/seed-load.ts",
    "db:bench:comments": "bun scripts/seeds/bench-comments.ts",
    "plugins:work": "bun --bun scripts/plugin-worker.ts",
    "typecheck": "bun check --no-script",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "fmt:staged": "bun fmt --staged",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "smoke": "bun scripts/smoke.ts",
    "generate:payload-admin-css": "bun run scripts/assets/generate-payload-admin-css.ts",
    "generate:scalar": "bun run scripts/assets/copy-scalar.ts",
    "generate-routes": "tsr generate",
    "eval:filter": "bun scripts/eval-filter-decider.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/api-key": "1.7.10",
    "@better-auth/drizzle-adapter": "1.7.10",
    "@fontsource-variable/geist": "^5.3.0",
    "@lst97-oss/last-comments-widgets": "^0.6.1",
    "@lst97-oss/last-httprism": "0.2.0",
    "@openrouter/sdk": "^1.5.7",
    "@payloadcms/db-postgres": "4.0.0-beta.4",
    "@payloadcms/drizzle": "4.0.0-beta.4",
    "@payloadcms/richtext-lexical": "4.0.0-beta.4",
    "@payloadcms/tanstack-start": "4.0.0-beta.4",
    "@payloadcms/translations": "4.0.0-beta.4",
    "@payloadcms/ui": "4.0.0-beta.4",
    "@scalar/api-reference": "^1.76.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-form-start": "1.33.5",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-store": "0.11.2",
    "bad-words": "^4.1.5",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "driver.js": "^1.10.2",
    "drizzle-orm": "0.45.2",
    "fontkit": "^2.0.4",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.8",
    "fumadocs-ui": "16.17.7",
    "katex": "^0.19.1",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "next-themes": "^0.4.6",
    "payload": "4.0.0-beta.4",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.8.0",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tanstack/router-cli": "^1.167.46",
    "@types/fontkit": "^2.0.9",
    "@types/mdx": "2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "bun-types": "^1.4.4",
    "drizzle-kit": "0.31.11",
    "nitro": "^3.0.260903-beta",
    "oxc-transform-react": "0.152.0",
    "typescript": "^5.9.3",
    "unwasm": "0.6.1",
    "vite": "^8.3.5"
  }
}
